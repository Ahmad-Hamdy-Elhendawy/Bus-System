# ============================================
# Cloud Bus Pass System - .gitignore
# ============================================

# -------------------------------
# Lambda deployment packages
# -------------------------------
*.zip
lambda-*.zip
package/
__pycache__/
*.pyc
*.pyo

# -------------------------------
# Terraform files
# -------------------------------
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
terraform.tfvars
*.tfvars
terraform.log

# -------------------------------
# Environment variables & secrets
# -------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json

# -------------------------------
# Stripe keys (never commit)
# -------------------------------
# Files containing API keys
*secret*
*key*
credentials.json

# -------------------------------
# IDE files
# -------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# -------------------------------
# OS files
# -------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -------------------------------
# Logs
# -------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
cloudwatch-logs/

# -------------------------------
# Local testing
# -------------------------------
test/
tmp/
temp/
*.tmp

# -------------------------------
# Documentation build
# -------------------------------
docs/_build/
site/

# -------------------------------
# Node modules (if any frontend tools)
# -------------------------------
node_modules/
package-lock.json
yarn.lock

# -------------------------------
# Python virtual environment
# -------------------------------
venv/
env/
ENV/
.venv/
__pycache__/

# -------------------------------
# Backup files
# -------------------------------
*.bak
*.backup
*.old
